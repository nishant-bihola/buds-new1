# Gemini AI (already configured)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_APP_URL=https://buds-n-buddies-v2.vercel.app

# Admin dashboard (set to any strong random string)
ADMIN_SECRET=your_super_secret_string

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM=Bud N Buddies <orders@yourdomain.com>

# Twilio (SMS — optional, leave blank to disable)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...

# Cron job auth
CRON_SECRET=your_cron_secret
