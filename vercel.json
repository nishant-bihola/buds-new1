{
  "buildCommand": "npm install && npm run build",
  "devCommand": "cd frontend && vite --port $PORT",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/clickncollect/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clickncollect",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin?_path=$1"
    },
    {
      "source": "/api/barnet/(.*)",
      "destination": "/api/barnet?_path=$1"
    },
    {
      "source": "/api/products/(.*)",
      "destination": "/api/products?id=$1"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "/api/orders?id=$1"
    },
    {
      "source": "/api/promos/validate",
      "destination": "/api/promos"
    },
    {
      "source": "/api/delivery/quote",
      "destination": "/api/delivery"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "video/mp4" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
